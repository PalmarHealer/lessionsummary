# Public URL of LessionSummary (no trailing slash). Also the OAuth redirect base:
# OpenSax must list <ORIGIN>/auth/callback as redirect URI.
ORIGIN=https://summary.example.com

# ── Login via OpenSax ──────────────────────────────────────────────────
OPENSAX_URL=https://opensax.example.com
OPENSAX_CLIENT_ID=lessionsummary
# openssl rand -hex 32 — the same value goes into OPENSAX_OAUTH_CLIENTS on OpenSax:
# [{"client_id":"lessionsummary","client_secret":"<this>","client_name":"LessionSummary",
#   "redirect_uris":["https://summary.example.com/auth/callback"],
#   "scopes":["openid","profile","school"],"trusted":true}]
OPENSAX_CLIENT_SECRET=

# ── Machines ───────────────────────────────────────────────────────────
# Shared secret of the Whisper worker(s) (worker/.env → LS_WORKER_TOKEN)
LS_WORKER_TOKEN=
# Optional: token for the summary API/MCP that sees *every* unit — for one
# scheduled task that summarises for all users. Leave empty to only allow
# per-user tokens from Settings → API-Tokens.
LS_ADMIN_TOKEN=

LS_MAX_UPLOAD_MB=2048
# Interface the port binds to; put a TLS reverse proxy in front.
BIND_HOST=127.0.0.1

# ── Local development only ─────────────────────────────────────────────
# LS_DEV_LOGIN=1   # login form without OpenSax (ignored in production builds)
