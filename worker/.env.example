# Web app the worker pulls jobs from
LS_URL=https://summary.example.com
# Worker token from the LessionSummary admin settings
LS_WORKER_TOKEN=

# Defaults to the hostname
#WORKER_ID=home-pc
# transcribe, extract, or both
WORKER_KINDS=transcribe,extract

WHISPER_MODEL=large-v3
# cuda | cpu
WHISPER_DEVICE=cuda
# float16 on GPU; int8 on CPU or GPUs with < 8 GB VRAM
#WHISPER_COMPUTE_TYPE=float16
# Lower to 4-8 if you run out of VRAM
WHISPER_BATCH_SIZE=16
# 1 = keep only one model on the GPU at a time (reload per job)
#LOW_VRAM=1

# 6 GB cards (e.g. RTX 3050/2060): large-v3 fits with
#   WHISPER_COMPUTE_TYPE=int8_float16
#   WHISPER_BATCH_SIZE=4
#   LOW_VRAM=1
# or use WHISPER_MODEL=large-v3-turbo for roughly 3x the speed.

# HuggingFace read token; accept the pyannote model terms first (see README)
HF_TOKEN=
DIARIZE=true

# Empty = autodetect per recording
DEFAULT_LANGUAGE=de
POLL_INTERVAL=5
# 1 = process everything open and exit (same as --drain)
#DRAIN=1
